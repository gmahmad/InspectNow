@InspectNow.Api_HostAddress = http://localhost:5117

GET {{InspectNow.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

@baseUrl = https://localhost:7145

### Create a draft inspection template
POST {{baseUrl}}/api/inspection-templates
Content-Type: application/json

{
  "name": "Office Cleaning Inspection"
}

### Reject a blank name
POST {{baseUrl}}/api/inspection-templates
Content-Type: application/json

{
  "name": "   "
}

### Retrieve the template already created
GET {{baseUrl}}/api/inspection-templates/163648a9-dfe5-4817-b275-964234c12040
Accept: application/json

### Request a nonexistent template
GET {{baseUrl}}/api/inspection-templates/00000000-0000-0000-0000-000000000000
Accept: application/json

### Add a question to our existing draft
POST {{baseUrl}}/api/inspection-templates/163648a9-dfe5-4817-b275-964234c12040/questions
Content-Type: application/json

{
  "text": "Are the floors clean???",
  "isRequired": true
}

### Reject blank question text
POST {{baseUrl}}/api/inspection-templates/163648a9-dfe5-4817-b275-964234c12040/questions
Content-Type: application/json

{
  "text": "   ",
  "isRequired": true
}

### Handle a missing template
POST {{baseUrl}}/api/inspection-templates/00000000-0000-0000-0000-000000000000/questions
Content-Type: application/json

{
  "text": "Are the floors clean?",
  "isRequired": true
}

### Get the template with its questions
GET {{baseUrl}}/api/inspection-templates/163648a9-dfe5-4817-b275-964234c12040
Accept: application/json

### Publish our template
POST {{baseUrl}}/api/inspection-templates/163648a9-dfe5-4817-b275-964234c12040/publish

### Read the published template
GET {{baseUrl}}/api/inspection-templates/163648a9-dfe5-4817-b275-964234c12040
Accept: application/json

### Reject adding a question after publishing
POST {{baseUrl}}/api/inspection-templates/163648a9-dfe5-4817-b275-964234c12040/questions
Content-Type: application/json

{
  "text": "This question should not be saved.",
  "isRequired": false
}

### Reject publishing a missing template
POST {{baseUrl}}/api/inspection-templates/00000000-0000-0000-0000-000000000000/publish